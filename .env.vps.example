# Copie para .env.vps no VPS e substitua TODOS os valores marcados.
# Nunca versionar .env.vps.
DOCKER_COMPOSE_PROJECT_NAME=zia-trader-vps
ENVIRONMENT=production
POSTGRES_DB=zia_trader
POSTGRES_USER=zia
POSTGRES_PASSWORD=replace-with-generated-postgres-password
REDIS_PASSWORD=replace-with-generated-redis-password
AUTH_USERNAME=zia-admin
AUTH_PASSWORD=replace-with-generated-admin-password
SECRET_KEY=replace-with-at-least-32-random-bytes

# Persistência obrigatória no VPS.
REQUIRE_PERSISTENT_DATABASE=true
REQUIRE_PERSISTENT_REDIS=true
REDIS_REQUIRED_FOR_AUTONOMOUS=true

# Fase inicial: histórico, shadow e paper/demo; nunca live automaticamente.
BINANCE_MODE=simulated
BINANCE_PUBLIC_BASE_URL=https://data-api.binance.vision
BINANCE_BASE_URL_DEMO=https://demo-api.binance.com/api
BINANCE_BASE_URL_TESTNET=https://testnet.binance.vision/api
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=
SHADOW_MODE_ENABLED=true
AUTONOMOUS_TRADING_ENABLED=false
MANUAL_TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
LIVE_MODE=false
LIVE_KILL_SWITCH=true
AUTO_START_ENGINES=false
DEMO_AUTH_ENABLED=false
OCO_ENABLED=true
DECISION_LOCK_TTL_SECONDS=30
DECISION_LOCK_RENEW_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_MAX_CONNECTIONS=50
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_PROVIDER_CONCURRENCY=10
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
QUOTE_CACHE_TTL_SECONDS=30
NEWS_CACHE_TTL_SECONDS=300

# Perímetro: deixe false durante a preparação; ative apenas após instalar certificados e firewall no VPS.
REQUIRE_TLS_PROXY=false
TLS_CERT_DIR=deploy/tls
TLS_PREFLIGHT_URL=https://127.0.0.1:8443/
FIREWALL_PREFLIGHT_REQUIRED=false
HTTPS_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443

# News/tendências: preencher apenas com chaves próprias, se necessário.
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_KEY=
MARKETAUX_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWSAPI_API_KEY=
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=

# Coleta desacoplada: o feed atualiza snapshots, e o ciclo de decisão lê o último estado.
SNAPSHOT_SYMBOLS=BTCUSDT,ETHUSDT
SNAPSHOT_INTERVALS=1h,4h
SNAPSHOT_LIMIT=250
SNAPSHOT_CONCURRENCY=4

# Backtest mensal histórico, sem ordens.
BACKTEST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,LTCUSDT,LINKUSDT,AVAXUSDT
BACKTEST_INTERVAL=1h
BACKTEST_DAYS=31
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1
CORS_ALLOW_CREDENTIALS=false
