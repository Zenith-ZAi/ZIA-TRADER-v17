# Ambiente
ENVIRONMENT=development
AUTO_START_ENGINES=false
DEMO_AUTH_ENABLED=true
DEMO_USER_PASSWORD=change-me
DEMO_ADMIN_PASSWORD=change-me-now
AUTH_MODE=demo
AUTH_USERNAME=
AUTH_PASSWORD=

# Persistência e cache
DATABASE_URL=sqlite:///./data/zia_trader.db
REDIS_URL=redis://localhost:6379/0

# Segurança: gere um valor aleatório forte antes de usar fora do desenvolvimento
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Exchange: simulated é o padrão; só use testnet/demo com chaves sandbox
BINANCE_MODE=simulated
BINANCE_BASE_URL=
BINANCE_BASE_URL_DEMO=https://demo-api.binance.com/api
BINANCE_BASE_URL_TESTNET=https://testnet.binance.vision/api
# Aliases aceitos em sandboxes externos
BINANCE_DEMO_BASE_URL=
BINANCE_SPOT_BASE_URL=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000
BINANCE_PRELOAD_EXCHANGE_INFO=false

# Trading
TRADING_LOOP_INTERVAL=5
ERROR_RETRY_INTERVAL=10
SNIPER_CYCLE_INTERVAL_SECONDS=1
SNIPER_TRADE_QUANTITY=0.001
MAX_RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
DAILY_LOSS_LIMIT_PERCENT=0.05
MAX_EXPOSURE_PER_SYMBOL=0.10
MAX_TOTAL_EXPOSURE=0.30

# Backtest e estresse
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.001
BACKTEST_STOP_LOSS_PCT=0.02
BACKTEST_TAKE_PROFIT_PCT=0.05
BACKTEST_MAX_VOLATILITY=0.08

# Integrações opcionais de notícias e tendências
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_KEY=
COINGECKO_API_KEY=
NEWSAPI_API_KEY=
CRYPTOPANIC_API_KEY=
POLYGON_API_KEY=

# URLs podem ser substituídas por endpoints licenciados ou proxy interno
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BENZINGA_NEWS_URL=https://api.benzinga.com/api/v2/news
BENZINGA_TRENDS_URL=https://api.benzinga.com/api/v1/trending-tickers
NEWSAPI_BASE_URL=https://newsapi.org/v2/everything
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/GROWTH/v2/posts/
NEWS_HTTP_TIMEOUT_SECONDS=8
NEWS_CACHE_TTL_SECONDS=300
NEWS_MAX_ARTICLES=20

# Observabilidade
OTEL_SERVICE_NAME=zia-trader
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
API_RATE_LIMIT=100
API_RATE_LIMIT_INTERVAL=60
