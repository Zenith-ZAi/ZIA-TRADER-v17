# Ambiente
ENVIRONMENT=development
AUTO_START_ENGINES=false
ORDER_MANAGER_MODE=manual
ORDER_CONFIRMATION_REQUIRED=true
MANUAL_TRADING_ENABLED=false
# Travas de segurança: manter false até concluir validação fora da amostra
AUTONOMOUS_TRADING_ENABLED=false
SHADOW_MODE_ENABLED=true
NEURAL_MODELS_ENABLED=false
TRANSFORMER_WEIGHTS_PATH=models/transformer.pt
LSTM_WEIGHTS_PATH=models/lstm.pt
DEMO_AUTH_ENABLED=true
DEMO_USER_PASSWORD=change-me
DEMO_ADMIN_PASSWORD=change-me-now
AUTH_MODE=demo
AUTH_USERNAME=
AUTH_PASSWORD=

# Persistência e cache
DATABASE_URL=sqlite:///./data/zia_trader.db
REDIS_URL=redis://localhost:6379/0

# Segurança: gere um valor aleatório forte antes de usar fora do desenvolvimento
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# Adapter de mercado: binance é default; forex usa paper por segurança
MARKET_ADAPTER=binance
MARKET_TYPE=spot
CCXT_EXCHANGE_ID=binance
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
FOREX_MODE=paper
FOREX_PAPER_SPREAD=0.0001
FOREX_TICK_SIZE=0.00001
# Exchange: simulated é o padrão; só use testnet/demo com chaves sandbox
BINANCE_MODE=simulated
BINANCE_BASE_URL=
BINANCE_BASE_URL_DEMO=https://demo-api.binance.com/api
BINANCE_BASE_URL_TESTNET=https://testnet.binance.vision/api
# Aliases aceitos em sandboxes externos
BINANCE_DEMO_BASE_URL=
BINANCE_SPOT_BASE_URL=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TIMEOUT_SECONDS=10
BINANCE_RECV_WINDOW_MS=5000
BINANCE_PRELOAD_EXCHANGE_INFO=false

# Trading
TRADING_LOOP_INTERVAL=5
ERROR_RETRY_INTERVAL=10
ANALYSIS_TIMEFRAMES=1m,5m,1h
MULTI_TIMEFRAME_ENABLED=false
MULTI_TIMEFRAME_MIN_CONFIRMATIONS=2
SNIPER_CYCLE_INTERVAL_SECONDS=1
SNIPER_ENABLED=false
SNIPER_TRADE_QUANTITY=0.001
MAX_RISK_PER_TRADE=0.02
KELLY_FRACTION=0.5
ADAPTIVE_KELLY_ENABLED=true
ADAPTIVE_KELLY_FRACTION=0.25
KELLY_TARGET_VOLATILITY=0.02
KELLY_MAX_RISK_FRACTION=0.02
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
# Binance Spot não abre short; manter false salvo uso de margem/futuros explicitamente configurado
ALLOW_SHORT=false
DAILY_LOSS_LIMIT_PERCENT=0.05
MAX_EXPOSURE_PER_SYMBOL=0.10
MAX_TOTAL_EXPOSURE=0.30
PORTFOLIO_LOW_CORRELATION_THRESHOLD=0.30
PORTFOLIO_MAX_WEIGHT=1.0
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_MAX_DRAWDOWN_PERCENT=0.15
EMERGENCY_EXIT_ENABLED=false
EMERGENCY_EXIT_ON_NEWS_SHOCK=false
EMERGENCY_EXIT_ON_EVENT=false
REDIS_REQUIRED_FOR_AUTONOMOUS=true

# Estratégia Pullback LTA/LTB em três camadas
PULLBACK_STRATEGY_ENABLED=true
PULLBACK_EMA_PERIOD=200
PULLBACK_RSI_PERIOD=14
PULLBACK_ATR_PERIOD=14
PULLBACK_VOLUME_PERIOD=20
PULLBACK_EXHAUSTION_VOLUME_RATIO=0.80
PULLBACK_TRIGGER_VOLUME_RATIO=1.30
PULLBACK_STOP_ATR_MULTIPLE=1.5
PULLBACK_TARGET_ATR_MULTIPLE=2.0
PULLBACK_BREAKEVEN_ATR_TRIGGER=0.5
ECONOMIC_EVENTS_FILE=data/economic_events.json
EVENT_BLOCK_BEFORE_SECONDS=60
EVENT_BLOCK_AFTER_SECONDS=300
MICROSTRUCTURE_GATE_ENABLED=true
MAX_SPREAD_BPS=30
MAX_ESTIMATED_SLIPPAGE_BPS=20
MIN_REWARD_RISK_RATIO=1.2
COST_AWARE_EXECUTION_ENABLED=true
MAX_BOOK_IMPACT=0.10

# Fricção Sandbox/backtest; manter false em produção
FRICTION_ENABLED=false
FRICTION_SLEEP_ENABLED=false
FRICTION_MIN_LATENCY_MS=150
FRICTION_MAX_LATENCY_MS=500
FRICTION_MIN_SLIPPAGE_TICKS=0.5
FRICTION_MAX_SLIPPAGE_TICKS=2.0
FRICTION_COMMISSION_RATE=0.0005
FRICTION_SPREAD_PRICE=0.0
FRICTION_TICK_SIZE=0.01
FRICTION_SEED=42

# Backtest e estresse
BACKTEST_INITIAL_CAPITAL=10000
BACKTEST_FEE_RATE=0.001
BACKTEST_STOP_LOSS_PCT=0.02
BACKTEST_TAKE_PROFIT_PCT=0.05
BACKTEST_MAX_VOLATILITY=0.08
RISK_FREE_RATE_ANNUAL=0.0
METRICS_PERIODS_PER_YEAR=252
OPTIMIZER_MAX_EVALUATIONS=32
OPTIMIZER_MAX_SECONDS=540
OPTIMIZER_VALIDATION_FRACTION=0.30
OPTIMIZER_MIN_TRADES=3
OPTIMIZER_REOPTIMIZE_EVERY=50

# Memória histórica de padrões: exige padrões encerrados e rotulados; desativada por padrão
PATTERN_MEMORY_ENABLED=false
PATTERN_MEMORY_REQUIRE_PROFITABLE=true
PATTERN_MEMORY_MIN_OUTCOME_ATR=2.0
PATTERN_MEMORY_MAX_DISTANCE=1.25
PATTERN_MEMORY_MIN_SAMPLES=3

# Integrações opcionais de notícias e tendências; nunca versionar valores reais
ALPHA_VANTAGE_API_KEY=
BENZINGA_API_KEY=
MARKETAUX_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
COINGECKO_API_KEY=
NEWSAPI_API_KEY=
CRYPTOPANIC_API_KEY=
POLYGON_API_KEY=

# URLs podem ser substituídas por endpoints licenciados ou proxy interno
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_RSS_URL_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BENZINGA_NEWS_URL=https://api.benzinga.com/api/v2/news
BENZINGA_TRENDS_URL=https://api.benzinga.com/api/v1/trending-tickers
NEWSAPI_BASE_URL=https://newsapi.org/v2/everything
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/GROWTH/v2/posts/
NEWS_HTTP_TIMEOUT_SECONDS=8
NEWS_CACHE_TTL_SECONDS=300
NEWS_MAX_ARTICLES=20
NEWS_PROVIDER_ARTICLES=10
NEWS_FAIL_CLOSED_FOR_ENTRY=true
NEWS_MIN_HEALTHY_PROVIDERS=1
NEWS_MIN_ARTICLES_FOR_ENTRY=1
NEWS_SHOCK_SENTIMENT_THRESHOLD=-0.65
NEWS_SHOCK_MIN_ARTICLES=3
NEWS_MAX_ARTICLE_AGE_SECONDS=7200
MARKETAUX_BASE_URL=https://api.marketaux.com/v1/news/all
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_NEWS_CATEGORY=crypto
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Observabilidade
OTEL_SERVICE_NAME=zia-trader
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
API_RATE_LIMIT=100
API_RATE_LIMIT_INTERVAL=60
